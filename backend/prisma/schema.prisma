generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ─────────────────────────────────────────────────────────────────

enum Rol {
  ADMINISTRADOR
  COORDINADOR
  OPERADOR
  SOLO_LECTURA
}

enum Sexo {
  M
  F
  X
}

enum CategoriaGasto {
  FIJOS
  VARIABLES
  ADMINISTRACION
  INVERSION
}

enum SubcategoriaGasto {
  ALQUILER
  INSUMOS
  SUELDOS
  SERVICIOS
  MANTENIMIENTO
  OTROS
}

enum MedioPago {
  EFECTIVO
  TRANSFERENCIA
  TARJETA_DEBITO
  TARJETA_CREDITO
  CHEQUE
}

enum EstadoGasto {
  PAGADO
  PENDIENTE
}

enum TipoIngreso {
  VENTA
  CUOTA
  DONACION
}

enum CategoriaIngreso {
  FIJO
  VARIABLE
}

enum EstadoIngreso {
  COBRADO
  PENDIENTE
}

enum EstadoAsociado {
  ACTIVO
  PENDIENTE
  INACTIVO
}

enum Patologia {
  ANSIEDAD
  INSOMNIO
  DOLOR
  EPILEPSIA
  ESTRES
  DEPRESION
  MIGRANA
  ARTRITIS
  FIBROMIALGIA
  PARKINSON
  TEA
  APETITO
  NAUSEAS
  INFLAMACION
  OTRA
}

enum EstadoCuota {
  AL_DIA
  PARCIAL
  PENDIENTE
  VENCIDA
}

// ─── Organización ──────────────────────────────────────────────────────────

model Sede {
  id           String   @id @default(cuid())
  nombre       String
  direccion    String
  localidad    String
  provincia    String
  codigoPostal String?
  telefono     String?
  email        String?
  activo       Boolean  @default(true)
  creadoEn     DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  usuarios Usuario[]

  @@map("sedes")
}

model ConfiguracionOrg {
  id            String   @id @default(cuid())
  clave         String   @unique
  valor         String
  actualizadoEn DateTime @updatedAt

  @@map("configuracion_org")
}

// ─── Usuarios y acceso ─────────────────────────────────────────────────────

model Usuario {
  id            String   @id @default(cuid())
  cuil          String   @unique
  nombre        String
  apellido      String
  email         String   @unique
  password      String
  rol           Rol      @default(OPERADOR)
  activo        Boolean  @default(true)
  sedeId        String?
  sede          Sede?    @relation(fields: [sedeId], references: [id])
  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  sesiones  Sesion[]
  auditoria Auditoria[]

  @@map("usuarios")
}

model Sesion {
  id           String   @id @default(cuid())
  usuarioId    String
  usuario      Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  refreshToken String   @unique
  ip           String?
  userAgent    String?
  activo       Boolean  @default(true)
  creadoEn     DateTime @default(now())
  expiraEn     DateTime

  @@map("sesiones")
}

// ─── Finanzas ──────────────────────────────────────────────────────────────

model Gasto {
  id            String            @id @default(cuid())
  fecha         DateTime
  categoria     CategoriaGasto
  subcategoria  SubcategoriaGasto
  descripcion   String
  monto         Decimal           @db.Decimal(14, 2)
  medioPago     MedioPago?
  estado        EstadoGasto       @default(PAGADO)
  notas         String?
  creadoEn      DateTime          @default(now())
  actualizadoEn DateTime          @updatedAt

  @@map("gastos")
}

model Ingreso {
  id            String           @id @default(cuid())
  fecha         DateTime
  tipo          TipoIngreso
  categoria     CategoriaIngreso
  descripcion   String
  monto         Decimal          @db.Decimal(14, 2)
  estado        EstadoIngreso    @default(COBRADO)
  observaciones String?
  creadoEn      DateTime         @default(now())
  actualizadoEn DateTime         @updatedAt

  @@map("ingresos")
}

// ─── Asociados ─────────────────────────────────────────────────────────────

model Asociado {
  id              String         @id @default(cuid())
  nombre          String
  apellido        String
  dni             String         @unique
  fechaNacimiento DateTime?
  telefono        String?
  email           String?
  direccion       String?
  fechaAlta       DateTime       @default(now())
  estado          EstadoAsociado @default(PENDIENTE)

  patologia     Patologia?
  patologiaOtra String?
  observaciones String?
  notasInternas String?

  estadoCuota   EstadoCuota @default(PENDIENTE)
  cuotaMensual  Decimal?   @db.Decimal(14, 2)

  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  seguimientos SeguimientoTerapeutico[]
  pagos        PagoAsociado[]
  cuotas       CuotaMes[]

  @@index([dni])
  @@index([estado])
  @@index([apellido, nombre])
  @@map("asociados")
}

model SeguimientoTerapeutico {
  id            String   @id @default(cuid())
  asociadoId    String
  asociado      Asociado @relation(fields: [asociadoId], references: [id], onDelete: Cascade)
  fecha         DateTime
  resultado     String
  observaciones String?
  continuidad   Boolean  @default(true)

  geneticaId String?
  loteId     String?
  plantaId   String?

  creadoEn DateTime @default(now())

  @@index([asociadoId])
  @@map("seguimientos_terapeuticos")
}

model CuotaMes {
  id         String   @id @default(cuid())
  asociadoId String
  asociado   Asociado @relation(fields: [asociadoId], references: [id], onDelete: Cascade)
  mes        String   // YYYY-MM
  monto      Decimal  @db.Decimal(14, 2)
  creadoEn   DateTime @default(now())

  @@unique([asociadoId, mes])
  @@index([asociadoId])
  @@map("cuotas_mensuales")
}

model PagoAsociado {
  id         String     @id @default(cuid())
  asociadoId String
  asociado   Asociado   @relation(fields: [asociadoId], references: [id], onDelete: Cascade)
  monto      Decimal    @db.Decimal(14, 2)
  fecha      DateTime
  concepto   String?
  medioPago  MedioPago?
  mesCuota   String?    // YYYY-MM: mes al que aplica este pago
  ingresoId  String?    // referencia al Ingreso creado automáticamente
  creadoEn   DateTime   @default(now())

  @@index([asociadoId])
  @@map("pagos_asociados")
}

// ─── Auditoría ─────────────────────────────────────────────────────────────

model Auditoria {
  id        String   @id @default(cuid())
  usuarioId String?
  usuario   Usuario? @relation(fields: [usuarioId], references: [id], onDelete: SetNull)
  accion    String
  entidad   String
  entidadId String?
  detalles  Json?
  ip        String?
  creadoEn  DateTime @default(now())

  @@map("auditoria")
}
